{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Full project rebuild",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/../../__build/application",
                "-j8"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../../__build/application"
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "Delete __build",
				"Create build directory",
                "Create makefile"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Build project",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/../../__build/application",
                "-j8"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../../__build/application"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Delete __build",
            "command": "rm",
            "args": [
                "-rf",
                "${workspaceFolder}/../../__build/application"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "shell",
            "label": "Create makefile",
            "command": "cmake",
            "args": [
                "-G",
                "Ninja",
				"${workspaceFolder}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../../__build/application"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "shell",
            "label": "Create build directory",
            "command": "mkdir",
            "args": [
                "-p",
                "${workspaceFolder}/../../__build/application"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "shell",
            "label": "Re-build project",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/../../__build/application",
                "--clean-first",
                "-v",
                "-j8"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../../__build/application"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "shell",
            "label": "Clean project (artifacts only)",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/../../__build/application",
                "--target",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../../__build/application"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Clean project (delete build dir)",
            "command": "rm",
            "args": [
                "-rf",
                "${workspaceFolder}/../../__build/application"
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "CubeProg: Flash project (SWD)",
            "command": "STM32_Programmer_CLI",
            "args": [
                "--connect",
                "port=swd",
                "--download",
                "${workspaceFolder}/../../__build/application/application.hex",
                "-hardRst"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "type": "shell",
            "label": "Start JDB_Server",
            "command": "JLinkGDBServerCL",
            "args": [
                "-device",
                "STM32H750XB",
                "-singlerun"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "close": true,
                "reveal": "never"
            }
        },
        {
            "type": "shell",
            "label": "Start arm-none-eabi-gdb",
            "command": "arm-none-eabi-gdb",
            "args": [
                "${workspaceFolder}/../../__build/application/application.hex",
                "-x",
                "${workspaceFolder}/scripts/program_bl.gdbinit"
            ],
            "presentation": {
                "close": true,
                "reveal": "never"
            }
        },
        {
            "label": "Jlink program",
            "dependsOn": [
                "Start JDB_Server",
                "Start arm-none-eabi-gdb"
            ],
            "problemMatcher": []
        }
    ]
}